@inbook{RefWorks:RefID:192-glikman2019humanwildlife,
	author={Jenny A. Glikman and Beatrice Frank and Silvio Marchini},
	editor={Frank,Beatrice and Glikman,Jenny A. and Marchini,Silvio},
	year={2019},
	title={Human–Wildlife Interactions: Multifaceted Approaches for Turning Conflict into Coexistence},
	booktitle={Human–Wildlife Interactions: Turning Conflict into Coexistence},
	series={Conservation Biology},
	publisher={Cambridge University Press},
	address={Cambridge},
	pages={439-452},
	abstract={Following the example of Woodroffe et al. (2005), we close the book by offering our conclusions and hopes for a future that entails coexisting with wildlife. Human–wildlife interactions – and clashes of opinions between stakeholders about how to deal with the encounters – will grow as the boundaries between human and wildlife space become more blurred. Through the innovative conceptual and applied contributions in this book, we aim to catalyse a paradigm shift from human–wildlife conflict discourses to human–wildlife interactions and coexistence dialogues. Exploring when and why people start to accept wildlife in their proximity is key to this endeavour, and represents a pathway by which we may begin to shift toward mechanisms that enhance the willingness to coexist with wild species.},
