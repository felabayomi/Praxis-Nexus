	author={Jessica L. Forrest and Eric Wikramanayake and Rinjan Shrestha and Gopala Areendran and Kinley Gyeltshen and Aishwarya Maheshwari and Sraboni Mazumdar and Robin Naidoo and Gokarna Jung Thapa and Kamal Thapa},
	year={2012},
	title={Conservation and climate change: Assessing the vulnerability of snow leopard habitat to treeline shift in the Himalaya},
