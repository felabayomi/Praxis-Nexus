@article{RefWorks:RefID:87-rockstrom2023safe,
	author={Johan Rockstrom and Joyeeta Gupta and Dahe Qin and Steven J. Lade and Jesse F. Abrams and Lauren S. Andersen and David I. Armstrong McKay and Xuemei Bai and Govindasamy Bala and Stuart E. Bunn and Daniel Ciobanu and Fabrice DeClerck and Kristie Ebi and Lauren Gifford and Christopher Gordon and Syezlin Hasan and Norichika Kanie and Timothy M. Lenton and Sina Loriani and Diana M. Liverman and Awaz Mohamed and Nebojsa Nakicenovic and David Obura and Daniel Ospina and Klaudia Prodani and Crelis Rammelt and Boris Sakschewski and Joeri Scholtens and Ben Stewart-Koster and Thejna Tharammal and Detlef van Vuuren and Peter H. Verburg and Ricarda Winkelmann and Caroline Zimm and Elena M. Bennett and Stefan Bringezu and Wendy Broadgate and Pamela A. Green and Lei Huang and Lisa Jacobson and Christopher Ndehedehe and Simona Pedde and Juan Rocha and Marten Scheffer and Lena Schulte-Uebbing and Wim de Vries and Cunde Xiao and Chi Xu and Xinwu Xu and Noelia Zafra-Calvo and Xin Zhang},
	year={2023},
	title={Safe and just Earth system boundaries},
	journal={Nature},
	volume={619},
	number={7968},
	pages={102-111},
	note={ID: Rockström2023},
	abstract={The stability and resilience of the Earth system and human well-being are inseparably linked1–3, yet their interdependencies are generally under-recognized; consequently, they are often treated independently4,5. Here, we use modelling and literature assessment to quantify safe and just Earth system boundaries (ESBs) for climate, the biosphere, water and nutrient cycles, and aerosols at global and subglobal scales. We propose ESBs for maintaining the resilience and stability of the Earth system (safe ESBs) and minimizing exposure to significant harm to humans from Earth system change (a necessary but not sufficient condition for justice)4. The stricter of the safe or just boundaries sets the integrated safe and just ESB. Our findings show that justice considerations constrain the integrated ESBs more than safety considerations for climate and atmospheric aerosol loading. Seven of eight globally quantified safe and just ESBs and at least two regional safe and just ESBs in over half of global land area are already exceeded. We propose that our assessment provides a quantitative foundation for safeguarding the global commons for all people now and into the future.},
	isbn={1476-4687},
	url={https://doi.org/10.1038/s41586-023-06083-8},
	doi={10.1038/s41586-023-06083-8}
}
