@article{RefWorks:RefID:198-srivastava2023edge,
	author={Shrey Srivastava},
	year={2023},
	title={On the Edge of the Wild: Confrontation between Humans and Wildlife – A Qualitative Study of Human Wildlife Conflict},
	journal={Jaipuria Institute of Management, Jaipur},
	abstract={Human-wildlife conflicts are on the rise around the world, and they frequently result in violence and ecological imbalance owing to a variety of circumstances. This research investigates the impact of this conflict on both humans and wildlife. The study employed a qualitative method to understand the numerous sources of concerns, such as habitat loss of wildlife, forest of fragmentation, and climate change, and looked at potential conservation mitigation measures. It investigates how habitat loss, encroachment, and resource rivalry in forest and agricultural areas are all contributing to a rise in human-wildlife conflict. The paper emphasises the negative consequences of these disputes, such as property destruction, monetary losses, threats to human safety, disturbance of typical patterns of conduct, and destruction of wildlife habitat. The study goes on to discuss the role of ecotourism as a sustainable alternative to mass tourism, recognising its benefits such as habitat preservation and revenue generation in addressing these concerns. In order to reduce interference with wildlife and its natural habits, the study also highlights the necessity for ethical wildlife tourism practises. It also focuses on the value of education and awareness campaigns in minimising human-wildlife conflict and stresses the significance of teaching the local population about wild animal behaviours and coexisting needs. Strengthening laws and regulations, implementing effective waste management, and promoting responsible behaviour among tourists are essential measures to reduce conflict. The integration of technology such as GPS and AI-powered surveillance systems is exploding as a means to monitor wildlife activities, combat poaching, and enhance conservation efforts; additionally, the establishment of wildlife corridors and habitat restoration projects are discussed as crucial for facilitating the movement of wildlife and maintaining ecosystem balance. The paper concludes by emphasising the need for sustainable solutions for peaceful coexistence between humans and wildlife and highlighting the significance of conserving biodiversity and maintaining ecosystem balance.},
	url={https://dx.doi.org/10.2139/ssrn.4513132}
}
